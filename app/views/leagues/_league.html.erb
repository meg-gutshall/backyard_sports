<div id="<%= dom_id league %>">
  <div>
    <strong>Name:</strong>
    <%= league.name %>
  </div>

  <div>
    <strong>Num teams:</strong>
    <%= league.num_teams %>
  </div>

  <div>
    <strong>Gender:</strong>
    <%= league.gender %>
  </div>

  <div>
    <strong>Age range:</strong>
    <%= league.age_range %>
  </div>

  <div>
    <strong>Location:</strong>
    <%= league.location %>
  </div>

  <div>
    <strong>Sport:</strong>
    <%= league.sport_id %>
  </div>

</div>

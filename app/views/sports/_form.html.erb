<%= form_with(model: sport) do |form| %>
  <% if sport.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(sport.errors.count, "error") %> prohibited this sport from being saved:</h2>

      <ul>
        <% sport.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :num_players, style: "display: block" %>
    <%= form.number_field :num_players %>
  </div>

  <div>
    <%= form.label :season, style: "display: block" %>
    <%= form.text_field :season %>
  </div>

  <div>
    <%= form.label :setting, style: "display: block" %>
    <%= form.text_field :setting %>
  </div>

  <div>
    <%= form.label :scoring_method, style: "display: block" %>
    <%= form.text_field :scoring_method %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>

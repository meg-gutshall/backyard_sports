<div id="<%= dom_id sport %>">
  <div>
    <strong>Name:</strong>
    <%= sport.name %>
  </div>

  <div>
    <strong>Num players:</strong>
    <%= sport.num_players %>
  </div>

  <div>
    <strong>Season:</strong>
    <%= sport.season %>
  </div>

  <div>
    <strong>Setting:</strong>
    <%= sport.setting %>
  </div>

  <div>
    <strong>Scoring method:</strong>
    <%= sport.scoring_method %>
  </div>

</div>
